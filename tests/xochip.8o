# Five things an XO-CHIP interpreter has to get right, one row each.
# A tick means the row passed. Built with Octo's compiler by scripts/build-tests.mjs.

:alias row vd
:alias col ve

: main
  hires
  v9 := 0
  row := 4

  # 1. scroll-up moves the picture up by the count given. A dot at row 40
  #    scrolled up by 4 must then collide with a dot drawn at row 36.
  i := dot
  v0 := 110
  v1 := 40
  sprite v0 v1 1
  scroll-up 4
  v1 := 36
  sprite v0 v1 1
  v2 := 1
  if vf != 1 then v2 := 0
  v1 := 36
  sprite v0 v1 1
  show-result

  # 2. i := long reaches memory above 4K. A byte written at 0x1234 must not
  #    appear at 0x234, which is where a twelve bit i would have put it.
  v0 := 0x5A
  i := long 0x1234
  save v0
  v0 := 0
  i := 0x234
  load v0
  v2 := 1
  if v0 == 0x5A then v2 := 0
  v0 := 0
  i := long 0x1234
  load v0
  if v0 != 0x5A then v2 := 0
  show-result

  # 3. A skip steps over the whole of i := long. The address word 0x6F01 is
  #    also the instruction vF := 1, so a two byte skip lands on it and runs it.
  vf := 0
  v0 := 1
  if v0 != 1 then i := long 0x6F01
  v2 := 1
  if vf != 0 then v2 := 0
  show-result

  # 4. Planes are separate. The same pixel drawn in plane 1 and then plane 2
  #    must not collide, since it is two pixels on two layers.
  plane 1
  i := dot
  v0 := 100
  v1 := 4
  sprite v0 v1 1
  plane 2
  sprite v0 v1 1
  v2 := 1
  if vf != 0 then v2 := 0
  plane 3
  sprite v0 v1 1
  plane 1
  show-result

  # 5. save vX - vY and load vX - vY keep i where it was. After both, loading
  #    from i has to give the first value back rather than something later.
  v3 := 7
  v4 := 8
  i := scratch
  save v3 - v4
  v3 := 0
  v4 := 0
  load v3 - v4
  v2 := 1
  if v3 != 7 then v2 := 0
  if v4 != 8 then v2 := 0
  load v0
  if v0 != 7 then v2 := 0
  show-result

  loop again

# Draws the row number from the built in font, then a tick or a cross.
: show-result
  v9 += 1
  col := 8
  i := hex v9
  sprite col row 5
  col := 16
  i := cross
  if v2 == 1 then i := tick
  sprite col row 5
  row += 8
  return

: tick
  0x08 0x10 0xA0 0x40 0x00
: cross
  0x88 0x50 0x20 0x50 0x88
: dot
  0x80
: scratch
  0x00 0x00 0x00 0x00
